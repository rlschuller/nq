SI_PREFIXES = [
    (10**3,  "k"),
    (10**6,  "M"),
    (10**9,  "G"),
    (10**12, "T"),
    (10**15, "P"),
    (10**18, "E"),
]


def format_si(n: int, decimals: int = 2) -> str:
    """Format an integer with an SI prefix.

    Parameters
    ----------
    n : int
        The integer to format.
    decimals : int, optional
        Number of decimal places in the output (default 2).

    Returns
    -------
    str
        Formatted string like ``"1.23k"``, ``"4.56M"``, or ``"789"``.

    Examples
    --------
    >>> format_si(1_234)
    '1.23k'
    >>> format_si(12_345_678, decimals=1)
    '12.3M'
    >>> format_si(999)
    '999.00'
    >>> format_si(1_000_000_000_000_000_000)
    '1.00E'
    >>> format_si(999_999_999, 0)
    '1G'
    """

    if n < 0:
        return f"-{format_si(-n, decimals)}"

    if n < 10**3:
        return f"{n}"

    # Pick starting prefix based on magnitude
    exp = math.floor(math.log10(n))
    idx = min(exp // 3 - 1, len(SI_PREFIXES) - 1)
    threshold, prefix = SI_PREFIXES[idx]

    # Bump up if rounding would push the scaled value to 1000+
    scaled = n / threshold
    while round(scaled, decimals) >= 1000 and idx < len(SI_PREFIXES) - 1:
        idx += 1
        threshold, prefix = SI_PREFIXES[idx]
        scaled = n / threshold

    return f"{scaled:.{decimals}f}{prefix}"



def filter_code(code):
    code = re.findall(r"```python\n[^`]*```", code)[-1]
    code = code[len("```python\n"):-len("```")]
    return code

def llm_request(prompt, api_config, user_data=None):
    api_key = "none"
    if not api_key:
        raise ValueError("Please set the OPENAI_API_KEY environment variable.")

    headers = {
        "Authorization": f"Bearer {api_config['key']}",
        "Content-Type": "application/json",
    }
    while api_config['url'][-1] == "/":
        api_config['url'] = api_config['url'][:-1]
    url = api_config['url'] + "/v1/responses"
    payload = api_config['payload'].copy()
    payload['input'] = [
        {"role": "developer", "content": prompt }
    ]

    if user_data is not None:
        payload['input'].append(
            {"role": "user", "content": user_data }
        )


    data = json.dumps(payload).encode("utf-8")
    req = Request(
            url,
            data=data,
            headers=headers,
            method="POST",
            )

    n_errors = 0

    res_json = None

    while True:
        try:
            with urlopen(req) as response:
                res_body = response.read().decode("utf-8")
                res_json = json.loads(res_body)
                text = res_json["output"][-1]["content"][-1]["text"]
                return text, res_json
            break

        except HTTPError as e:
            if n_errors < 10:
                n_errors += 1
            else:
                error_info = e.read().decode("utf-8")
                # raise RuntimeError(
                #     f"API Error (Status {e.code}): {error_info}"
                # ) from e
                return None, res_json

