def run_subprocess(cmd, preamble=None):
    if args.jsonl_files is not None:
        handles = [open(p) for p in args.jsonl_files]

        try:
            lines = []
            for vh in zip(*handles):
                lines.append(json.dumps([json.loads(x) for x in vh]))

            str_stdin = "\n".join(lines)+"\n"
            process = subprocess.Popen(
                cmd,
                stdin=subprocess.PIPE,
                text=True
            )
            process.communicate(input=str_stdin)
        finally:
            for h in handles:
                h.close()

        return
    else:
        if preamble is not None:
            process = subprocess.Popen(
                cmd,
                stdin=subprocess.PIPE,
                text=True,
            )
            process.stdin.write(preamble)
            shutil.copyfileobj(sys.stdin, process.stdin)
            process.stdin.close()
            process.wait()
        else:
            process = subprocess.Popen(
                cmd,
                stdin=sys.stdin,
                text=True
            )
            process.communicate()

    sys.stdout.flush()
    sys.stderr.flush()


if not args.prog and args.jsonl_files is None:
    inputs = []
    prompts = []
    i = 0

    if args.null:
