        user_data = data[1]
        return llm_request(prompt, api_config, user_data = user_data)

    cost = 0
    total_tokens = 0
    input_tokens = 0
    cached_tokens = 0
    output_tokens = 0
    with ThreadPoolExecutor(max_workers=max_threads) as executor:
        str_out = ""
        for i, out in enumerate(executor.map(run, prompts)):

            if "usage" in out[1] and "cost" in out[1]["usage"] and isinstance(out[1]["usage"]["cost"], Number):
                cost += out[1]["usage"]["cost"]

            if "usage" in out[1] and "total_tokens" in out[1]["usage"]:
                total_tokens += out[1]["usage"]["total_tokens"]

                # assume that if total_tokes is in usage, input and output also is...
                input_tokens += out[1]["usage"]["input_tokens"]

                output_tokens += out[1]["usage"]["output_tokens"]

                if "input_tokens_details" in  out[1]["usage"] and   "cached_tokens" in out[1]["usage"]["input_tokens_details"]:
                    cached_tokens += out[1]["usage"]["input_tokens_details"]["cached_tokens"]

            reply = out[0]
            input = inputs[i]

            if args.verbose:
                str_out += json.dumps(out[1], ensure_ascii=False) + "\n"
            else:
                str_out += json.dumps(reply.strip(), ensure_ascii=False) + "\n"

            if i % 32 == 0 and i != 0:
                dt = int((len(v) - i) * (time()-start)/i)
                sec = dt % 60
                minutes = (dt // 60) % 60
                h = dt // 3600

                str_dt = ""
                if h > 0:
                    str_dt += f"{h}h "
                if minutes > 0:
                    str_dt += f"{minutes}m "
                if sec > 0:
                    str_dt += f"{sec}s"

                estimated_cost = (cost / i) * len(v)

                print('\033[2K', file=sys.stderr, end='', flush=True)
                print(str_out, end='')

                print(f'{"\033[35m" if sys.stderr.isatty() else ""}ETA: {str_dt} ({math.floor(100 * i / len(v)):2d}%) | {format_si(total_tokens)} Tok ({int(100*cached_tokens/input_tokens)}% CH, {format_si(input_tokens)} In, {format_si(output_tokens)} Out) | $ {cost:0.5f} / $ {estimated_cost:0.5f}{"\033[0m" if sys.stderr.isatty() else ""}\r', file=sys.stderr, end='')
                str_out = ""

        print('\033[2K', file=sys.stderr, end='', flush=True)
        print(str_out, end='')

        dt = int(time()-start)
        sec = dt % 60
        minutes = (dt // 60) % 60
        h = dt // 3600

        str_dt = ""
        if h > 0:
            str_dt += f"{h}h "
